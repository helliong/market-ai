generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  sellerId    String
  storeName   String
  sku         String   @unique
  name        String
  description String   @default("")
  category    String
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  status      String   @default("active")
  isSellerPaused Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([category])
}
