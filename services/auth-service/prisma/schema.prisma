generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SellerStatus {
  PENDING_LEGAL_DATA
  UNDER_REVIEW
  ACTIVATED
  SUSPENDED
  REJECTED
}

enum CredentialScope {
  BUYER
  SELLER
}

model Account {
  id                      String      @id @default(cuid())
  email                   String      @unique
  isEmailVerified         Boolean     @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user                    User?
  seller                  UserSeller?
  credentials             AccountCredential[]
}

model AccountCredential {
  id               String          @id @default(cuid())
  accountId        String
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scope            CredentialScope
  passwordHash     String
  refreshTokenHash String?
  resetCode        String?
  resetCodeExpires DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([accountId, scope])
}

model User {
  id          String   @id @default(cuid())
  accountId  String   @unique
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email       String
  displayName String
  phone       String?
  birthDate   DateTime?
  gender      String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSeller {
  id                  String       @id @default(cuid())
  accountId           String       @unique
  account             Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email               String
  storeName           String
  ownerEmail          String
  ownerName           String
  status              SellerStatus @default(PENDING_LEGAL_DATA)
  reviewComment       String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  agreementAcceptedAt DateTime
  legalName           String?
  inn                 String?
  phone               String?
  description         String?
  city                String?
  isPaused            Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  legalProfile        SellerLegalProfile?
}

model SellerLegalProfile {
  id           String     @id @default(cuid())
  sellerId     String     @unique
  seller       UserSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  businessType String
  taxId        String
  legalName    String
  legalAddress String
  bankName     String
  iban         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
